# Local / IntelliJ. Docker overrides via env/comment.env on the server.
# Infra MySQL host port is 3307.

DB_URL=jdbc:mysql://127.0.0.1:3307/comment_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=comment_user
DB_PASSWORD=comment_pass
JPA_DDL_AUTO=update
EUREKA_CLIENT_ENABLED=false
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
SERVER_PORT=0
KAFKA_ENABLED=false
KAFKA_LISTENER_ENABLED=false
OUTBOX_PUBLISHER_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092